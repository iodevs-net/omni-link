# Omni-Link Configuration
# Copy to .env or set as environment variables before starting the MCP server.

# Workspace root for cross-project impact analysis.
# Default: parent of CWD (i.e., ../ from project root)
# OMNI_LINK_WORKSPACE=/home/user/dev/proyectos

# Custom path to ast-grep binary (sg).
# Default: auto-detected via PATH, then ~/.cargo/bin/sg
# OMNI_LINK_SG_PATH=/usr/local/bin/sg

# Enable debug logging (any value enables it)
# OMNI_LINK_DEBUG=true
